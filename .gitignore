# Runtime artefacts. None of these belong in version control.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Written on first boot by app.main._bootstrap. It holds a live administrator
# password in clear text, so it must never be committed.
INITIAL_ADMIN.txt

# Local database and backups.
data/*.db
data/*.db-wal
data/*.db-shm
backup/

# Secrets.
.env
deploy/.env

# Screenshots are regenerated by tools/ui_check.py and tools/shot.py.
shots/
