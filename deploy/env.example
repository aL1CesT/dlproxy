# dlproxy environment file template
#
#   cp deploy/env.example /opt/dlproxy/.env && chmod 600 /opt/dlproxy/.env
#
# deploy.sh copies this to <app-root>/.env with mode 0600. The template itself
# is not named .env so that it stays in version control.
#
# SINGLE SOURCE OF TRUTH RULE: this file holds exactly ONE secret, the session
# signing key. Every other tunable (SMTP credentials, quotas, concurrency caps,
# admin path) lives in the `settings` table and is edited from the admin page.
# Do not add a second write path for those values.

# HMAC key for the session cookie (itsdangerous). deploy.sh generates it with
# `openssl rand -hex 32`. Rotating it invalidates all sessions but not user tokens.
DLPROXY_SECRET_KEY=replace-me-with-64-hex-chars

# SQLite location. Defaults to <app-root>/data/app.db when unset.
# DLPROXY_DB_PATH=/opt/dlproxy/data/app.db

# Bind address. Keep 127.0.0.1 — Nginx is the only public listener.
DLPROXY_HOST=127.0.0.1
DLPROXY_PORT=8080

# Set to 1 when running behind Nginx (trusts X-Real-IP / X-Forwarded-Proto).
# Set to 0 only for direct local testing, where client IP comes from the socket.
DLPROXY_BEHIND_PROXY=1
