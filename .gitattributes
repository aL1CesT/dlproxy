# Everything in this repo is LF, on every platform. The shell entry points are
# executable so `git archive` / `scp` keeps them runnable.
* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.md            text eol=lf
*.conf          text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.service       text eol=lf

deploy/*.sh     text eol=lf
